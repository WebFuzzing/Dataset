					<finalName>reciter</finalName>
					<classifier>sut</classifier>
				</configuration>
				<!-- MODIFIED -->
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
