{
  "name": "CscaMasterlistSync",
  "version": "1.0.0",
  "description": "Lambda function to synchronize CSCA Masterlist from Italian Ministry of Interior - SHA256 verification only",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test-build": "npm run-script test && npm run-script coverage &&  npm run-script build",
    "build": "rm -f ./function.zip && zip -r ./function.zip . -x './src/test/*' -x '*.md' -x '*.env' -x './coverage/*' -x './.nyc_output/*' -x './.scannerwork/*' -x 'node_modules/@aws-sdk/*'",
    "test": "nyc --reporter=html --reporter=text mocha './src/test/**/*.test.js' --recursive --timeout=10000 --exit -r dotenv/config",
    "coverage": "nyc report --reporter=lcov"
  },
  "keywords": [
    "aws",
    "lambda",
    "csca",
    "masterlist",
    "s3",
    "ssm",
    "ecs"
  ],
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/client-ssm": "^3.1026.0",
    "@aws-sdk/client-ecs": "^3.1026.0",
    "aws-sdk-client-mock": "^4.1.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "mocha": "^10.8.2",
    "nock": "^13.5.4",
    "node-fetch": "^2.7.0",
    "nyc": "^17.1.0",
    "proxyquire": "^2.1.3",
    "sinon": "^19.0.2"
  }
}